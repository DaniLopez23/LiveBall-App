# Single-EC2 deployment: Nginx is the only public entry point.
FRONTEND_PORT=80
BACKEND_PORT=8000

ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=

# Leave empty to use the EC2 public host for HTTP and WebSocket traffic.
VITE_API_URL=
VITE_WS_URL=
VITE_WS_BASE_URL=

# XML paths inside the shared Docker volume.
F24_XML_DIR=/shared/events
F9_XML_DIR=/shared/stats
F40_XML_PATH=/shared/players/F40-squad-23.xml
F42_XML_PATH=/shared/schedule/f42-23-2023-results.xml
XML_POLL_INTERVAL_SECONDS=3
STATS_XML_POLL_INTERVAL_SECONDS=60

# Match simulator inputs and outputs.
SIMULATE_EVENTS_DIR=/app/data/events/simulate
SIMULATE_STATS_DIR=/app/data/stats/simulate
STATIC_EVENTS_DIR=/app/data/events/static
STATIC_STATS_DIR=/app/data/stats/static
OUTPUT_EVENTS_DIR=/shared/events
OUTPUT_STATS_DIR=/shared/stats
F40_SOURCE_XML_PATH=/app/data/players/F40-squad-23.xml
F40_OUTPUT_XML_PATH=/shared/players/F40-squad-23.xml
F42_SOURCE_XML_PATH=/app/data/schedule/f42-23-2023-results.xml
F42_OUTPUT_XML_PATH=/shared/schedule/f42-23-2023-results.xml
SIMULATION_SPEED=1
WRITE_INTERVAL_SECONDS=3
